# Solo funciona en Apache. En Nginx este archivo se ignora (ver las notas de instalación).
Options -Indexes

# Que nadie pueda descargar la base de datos, los respaldos ni los archivos internos.
<FilesMatch "\.(sqlite|sqlite3|db|sql|log)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(config|db)\.php$">
    Require all denied
</FilesMatch>
